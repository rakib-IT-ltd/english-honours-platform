{
  "name": "english-honours-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Bilingual academic learning platform for English Honours students in Bangladesh (monorepo).",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:api": "pnpm --filter @ehp/shared-types build && pnpm --filter @ehp/api start:dev",
    "dev:web": "pnpm --filter @ehp/shared-types build && pnpm --filter @ehp/web dev",
    "db:generate": "pnpm --filter @ehp/api db:generate",
    "db:migrate": "pnpm --filter @ehp/api db:migrate",
    "db:migrate:deploy": "pnpm --filter @ehp/api db:migrate:deploy",
    "db:seed": "pnpm --filter @ehp/api db:seed",
    "db:load-content": "pnpm --filter @ehp/api db:load-content",
    "db:load-sample": "pnpm --filter @ehp/api db:load-sample"
  },
  "devDependencies": {
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "typescript": "~6.0.3"
  }
}
