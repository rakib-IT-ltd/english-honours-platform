// Prisma schema.
//
// Module 1 - Academic structure (multi-university):
//
//   University -> Department -> AcademicProgram -> ProgramLevel -> Syllabus (a syllabus version)
//   AcademicLevel is a SHARED, university-independent list of the five platform levels.
//   AcademicSession and Syllabus (with its sources/verification) are university-specific.
//   Courses, topics and learning materials hang off Syllabus and are added in later modules.
//
// Further models (courses, content, users, ...) are added module by module after approval.
// The connection URL is supplied by prisma.config.ts (Prisma 7) from DATABASE_URL.
//
// Rules enforced OUTSIDE this file, in the SQL migrations (Prisma cannot express CHECK constraints):
//  - University.code is a lowercase URL-safe identifier.
//  - AcademicLevel.sequence >= 1; AcademicSession.endYear >= startYear.
// Same-university consistency IS enforced here, through composite foreign keys that carry
// universityId (see Department, AcademicSession, AcademicProgram and Syllabus).

generator client {
  provider     = "prisma-client"
  output       = "../../backend/api/src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Whether a syllabus has been checked against an official source document.
/// Nothing is VERIFIED unless a SyllabusVerification record exists (enforced in the service).
enum VerificationStatus {
  UNVERIFIED
  VERIFIED
}

/// Kind of academic program. Extend (with a migration) if other kinds are ever needed.
enum ProgrammeType {
  HONOURS
  MASTERS
}

/// What a syllabus source document is. Only OFFICIAL_UNIVERSITY_DOCUMENT can support verification.
enum SyllabusSourceType {
  OFFICIAL_UNIVERSITY_DOCUMENT
  OTHER
}

model University {
  id        String   @id @default(uuid())
  /// Short stable lowercase identifier, also used in website URLs (e.g. "nu"). Unique.
  code      String   @unique
  nameEn    String
  /// Bangla name; optional so unreviewed Bangla text is never forced in.
  nameBn    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments      Department[]
  academicPrograms AcademicProgram[]
  academicSessions AcademicSession[]
  syllabuses       Syllabus[]
}

model Department {
  id           String   @id @default(uuid())
  universityId String
  code         String
  nameEn       String
  nameBn       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  university       University        @relation(fields: [universityId], references: [id])
  academicPrograms AcademicProgram[]

  @@unique([universityId, code])
  /// Target of composite foreign keys that must stay inside one university.
  @@unique([id, universityId])
}

/// The five shared platform levels (Honours 1st-4th Year, Masters 1st Year). NOT per university.
model AcademicLevel {
  id            String   @id @default(uuid())
  /// Stable identifier, e.g. HONOURS_1 ... HONOURS_4, MASTERS_1.
  code          String   @unique
  /// Display order across all levels (1-based, unique).
  sequence      Int      @unique
  nameEn        String
  nameBn        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  programs   ProgramLevel[]
}

/// A degree program of one university, e.g. "English (Honours)" or "English (Masters)".
model AcademicProgram {
  id            String        @id @default(uuid())
  universityId  String
  departmentId  String
  /// Unique within the university.
  code          String
  programmeType ProgrammeType
  nameEn        String
  nameBn        String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  university University     @relation(fields: [universityId], references: [id])
  /// The department must belong to the same university.
  department Department     @relation(fields: [departmentId, universityId], references: [id, universityId])
  levels     ProgramLevel[]
  syllabuses Syllabus[]

  @@unique([universityId, code])
  @@unique([id, universityId])
  @@index([departmentId, universityId])
}

/// Which shared levels a program offers (e.g. an Honours program offers HONOURS_1..4).
model ProgramLevel {
  programId String
  levelId   String

  program AcademicProgram @relation(fields: [programId], references: [id])
  level   AcademicLevel   @relation(fields: [levelId], references: [id])
  syllabuses Syllabus[]

  @@id([programId, levelId])
  @@index([levelId])
}

/// A university's academic session, e.g. label "2024-2025". Meaning is defined by the university.
model AcademicSession {
  id           String   @id @default(uuid())
  universityId String
  label        String
  startYear    Int
  endYear      Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  university University @relation(fields: [universityId], references: [id])
  syllabuses Syllabus[]

  @@unique([universityId, label])
  @@unique([id, universityId])
}

/// A syllabus VERSION: one program + one shared level + one session + a version label, always
/// inside a single university. Courses (titles, codes, credits, marks) attach here in a later module.
model Syllabus {
  id                 String             @id @default(uuid())
  /// Denormalised on purpose: it lets the composite foreign keys below guarantee that program and
  /// session belong to the same university as the syllabus.
  universityId       String
  academicProgramId  String
  academicLevelId    String
  academicSessionId  String
  versionLabel       String
  verificationStatus VerificationStatus @default(UNVERIFIED)
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  university      University      @relation(fields: [universityId], references: [id])
  academicProgram AcademicProgram @relation(fields: [academicProgramId, universityId], references: [id, universityId])
  academicSession AcademicSession @relation(fields: [academicSessionId, universityId], references: [id, universityId])
  /// The program must actually offer this level.
  programLevel    ProgramLevel    @relation(fields: [academicProgramId, academicLevelId], references: [programId, levelId])
  sources         SyllabusSource[]
  verifications   SyllabusVerification[]

  /// Explicit name: the default would exceed PostgreSQL's 63-character identifier limit.
  @@unique([academicProgramId, academicLevelId, academicSessionId, versionLabel], map: "Syllabus_program_level_session_version_key")
  @@index([universityId])
  @@index([academicSessionId, universityId])
  @@index([academicProgramId, academicLevelId])
}

/// A source document a syllabus was taken from.
model SyllabusSource {
  id          String             @id @default(uuid())
  syllabusId  String
  sourceType  SyllabusSourceType @default(OTHER)
  title       String
  issuingBody String
  /// Path under academic-content/ or a URL to the original document.
  documentRef String
  publishedOn DateTime?          @db.Date
  /// SHA-256 of the stored document, to detect later changes.
  sha256      String?
  createdAt   DateTime           @default(now())

  syllabus Syllabus @relation(fields: [syllabusId], references: [id])

  @@index([syllabusId])
}

/// Append-only record that someone checked a syllabus against its source.
model SyllabusVerification {
  id         String   @id @default(uuid())
  syllabusId String
  /// Reviewer's name/identifier. Becomes a user reference once the users module exists.
  verifiedBy String
  note       String?
  verifiedAt DateTime @default(now())

  syllabus Syllabus @relation(fields: [syllabusId], references: [id])

  @@index([syllabusId])
}
