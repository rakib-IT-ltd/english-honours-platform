# English Honours Learning Platform - Web (Next.js) environment template.
#
# Copy to `.env.local` (git-ignored):  cp apps/web/.env.example apps/web/.env.local
# Anything prefixed NEXT_PUBLIC_ is embedded in the browser bundle: NEVER put secrets here.

# Base URL of the backend API as reached from the browser. The home page loads universities,
# programs, levels and syllabuses from it. When it is unset (e.g. the static GitHub Pages preview)
# the page shows a "not connected" notice and makes no requests. The API must allow this site's
# origin in its CORS setting.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
