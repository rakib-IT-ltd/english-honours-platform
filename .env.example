# Docker Compose development variables (database + optional containerised apps).
# This is the ROOT env template; each app also has its own (backend/api, apps/web, apps/mobile).
#
# Copy to `.env` (git-ignored):  cp .env.example .env
# then set a password of your own. Development only - never reuse these values in production.

POSTGRES_USER=ehp
POSTGRES_DB=ehp_dev
# Required: left empty on purpose - compose refuses to start until you set a password.
POSTGRES_PASSWORD=

# Host ports (databases are bound to 127.0.0.1 only).
POSTGRES_PORT=5432
API_PORT=3001
WEB_PORT=3000
