# English Honours Learning Platform - API (NestJS) environment template.
#
# Copy to `.env` (git-ignored) for local development:  cp backend/api/.env.example backend/api/.env
# Real environment variables always take precedence over this file. Never commit real values.
# Production values must be injected by the hosting platform's secret manager, not a file.

# development | test | production  (Swagger UI is disabled when production)
NODE_ENV=development

# Port the API listens on. Served under /api/v1, Swagger UI at /api/docs.
PORT=3001

# PostgreSQL connection string used by Prisma. Must match the root .env when using the
# bundled compose database. Replace CHANGE_ME with the password you chose there.
DATABASE_URL=postgresql://ehp:CHANGE_ME@localhost:5432/ehp_dev?schema=public

# Comma-separated list of browser origins allowed by CORS (the Next.js dev server by default).
CORS_ORIGINS=http://localhost:3000

# Firebase Authentication. The project id is not a secret. Without it, /me returns 503 and the
# rest of the API works normally. Production credentials come from the hosting platform
# (GOOGLE_APPLICATION_CREDENTIALS / workload identity), never from this repository.
FIREBASE_PROJECT_ID=demo-ehp
# Local development without a Firebase account: run the Auth Emulator and point the API at it.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# NOTE: Firebase Storage and LLM/RAG settings are intentionally absent. They are added, with
# validation, in the modules that first use them.
